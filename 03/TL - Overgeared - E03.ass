Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs24\c&H707070&\frx12\fry10\frz355.9\pos(987,762)}Meslek
Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs30\c&HB88168&\frz356.8\frx12\fry10\pos(1042,804)}Hitabetçi
Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs24\c&H707070&\frx12\fry10\frz355.9\pos(741,828)}Üyelik
Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs30\c&HB88168&\frz356.8\frx12\fry10\pos(753,870)}Yok
Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs24\c&H707070&\frx12\fry10\frz355.9\pos(735,909)}Silah
Dialogue: 0,0:13:14.89,0:13:19.90,sign_generic,sign,0,0,0,,{\an1\bord0\fs30\c&HB88168&\frz356.8\frx12\fry10\pos(762,954)}Hançer
Dialogue: 0,0:13:17.60,0:13:22.93,Default,Hinako,0,0,0,,24 yaşındaki Moğol kullanıcı,\Nşu anda 126. seviye bir Hitabetçi.
Dialogue: 0,0:13:23.40,0:13:26.66,Default,Hinako,0,0,0,,Bugüne kadarki en uzun\Nkesintisiz oturum süresi yirmi saatti.
Dialogue: 0,0:13:27.58,0:13:30.12,Default,Hinako,0,0,0,,Yaşamsal belirtilerinde\Nherhangi bir anormallik yoktu,
Dialogue: 0,0:13:30.12,0:13:33.12,Default,Hinako,0,0,0,,ancak psikolojik stres \Noldukça yüksek görünüyordu.
Dialogue: 0,0:13:33.12,0:13:37.12,Default,Hinako,0,0,0,,Kapsülün zorla çıkış mekanizması\Ndevreye girmek üzereydi.
Dialogue: 0,0:13:37.80,0:13:43.38,Default,Hinako,0,0,0,,Bu verilere göre, görevi tamamlama\Nihtimalini %9 olarak tahmin ediyoruz.
Dialogue: 0,0:13:43.79,0:13:45.12,Default,Yazaki,0,0,0,,Çok düşük.
Dialogue: 0,0:13:45.12,0:13:47.43,Default,Futaba,0,0,0,,Tehlike daha büyük...
Dialogue: 0,0:13:47.68,0:13:51.45,Default,Hinako,0,0,0,,Ayrıca, Huroi'yi kurtarmakla görevli \N"Adalet Elçisi"
Dialogue: 0,0:13:51.45,0:13:53.94,Default,Hinako,0,0,0,,aslında bir NPC olması gerekiyordu, ama...
Dialogue: 0,0:13:53.94,0:13:55.69,Default,Shisamura,0,0,0,,Bir değişken mi ortaya çıktı?
Dialogue: 0,0:13:55.69,0:13:57.46,Default,Shisamura,0,0,0,,Bu kaza...
Dialogue: 0,0:13:57.98,0:14:01.04,Default,Sakeda,0,0,0,,Görünüşe göre, görevi \Npaylaştığı kullanıcı
Dialogue: 0,0:14:01.04,0:14:04.48,Default,Sakeda,0,0,0,,Adalet Elçisi olarak değerlendirilecek.
Dialogue: 0,0:14:04.78,0:14:07.72,Default,Sakeda,0,0,0,,Her ne kadar kendisi\Nbunun farkında olmasa da.
Dialogue: 0,0:14:08.45,0:14:12.90,Default,Yazaki,0,0,0,,Peki, zindanda Huroi’yi kurtarabilecek mi?
Dialogue: 0,0:14:09.72,0:14:12.25,Default,Seira,0,0,0,,{\an8}Kardeşim, soğuk alacaksın.
Dialogue: 0,0:14:12.25,0:14:13.49,Default,Seira,0,0,0,,{\an8}İğrenç, bira kokusu geliyor!
Dialogue: 0,0:14:13.49,0:14:17.75,Default,Sakeda,0,0,0,,Bu NPC’nin gittiği yöne bakarak,
Dialogue: 0,0:14:18.05,0:14:19.93,Default,Sakeda,0,0,0,,bir teori geliştirebiliriz.
Dialogue: 0,0:14:20.89,0:14:26.26,Default,Sakeda,0,0,0,,Bunun anahtarı muhtemelen\Nüçüncü destansı mesleğin sahibi.
Dialogue: 0,0:14:29.38,0:14:30.75,Default,Rabbit,0,0,0,,Bir tesadüf...
Dialogue: 0,0:14:30.75,0:14:33.81,Default,Rabbit,0,0,0,,Ben tesadüflere pek inanmam.
Dialogue: 0,0:14:34.24,0:14:36.66,Default,Rabbit,0,0,0,,Ama bu işe yararsa,
Dialogue: 0,0:14:44.25,0:14:46.69,sign_generic,sign,0,0,0,,{\shad3\bord1\fs48\fad(216,0)\fnArial Black\c&HF5FAFC&\3c&H1B1B1B&\4c&H1B1B1B&\pos(712,885)}Ebedi Krallık, Kont Steim’in Toprakları
Dialogue: 0,0:14:44.25,0:14:46.69,sign_generic,sign,0,0,0,,{\shad3\bord1\fs48\fad(216,0)\fnArial Black\c&HFFFFFF&\3c&H1B1B1B&\4c&H1B1B1B&\pos(1298,885)}Akero Zindanı
Dialogue: 0,0:14:47.13,0:14:49.13,Default,Adventurers,0,0,0,,Lütfen grubumuza katıl!
Dialogue: 0,0:14:49.13,0:14:51.37,Default,Adventurers,0,0,0,,Hayır, bizimkine katıl!
Dialogue: 0,0:14:51.37,0:14:52.78,Default,Adventurers,0,0,0,,Lütfen!
Dialogue: 0,0:14:52.78,0:14:54.73,Default,Adventurers,0,0,0,,Euphemina-san!
Dialogue: 0,0:14:54.73,0:14:56.93,Default,Euphemina,0,0,0,,Tamam...
Dialogue: 0,0:14:56.93,0:15:04.67,Default,Euphemina,0,0,0,,O zaman lütfen bana neler\Nyapabileceğinizi gösterin!
Dialogue: 0,0:15:06.30,0:15:08.82,Default,Adventurers,0,0,0,,Euphemina-san bize ait!
Dialogue: 0,0:15:08.82,0:15:10.68,Default,Adventurers,0,0,0,,Hayır, bize!
Dialogue: 0,0:15:11.09,0:15:13.18,Default,Adventurers,0,0,0,,Patlayıcı Peçe!
Dialogue: 0,0:15:13.18,0:15:15.18,Default,Adventurers,0,0,0,,Yıldırım Kesici!
Dialogue: 0,0:15:16.22,0:15:17.71,Default,Euphemina,0,0,0,,Hmm...
Dialogue: 0,0:15:17.71,0:15:20.69,Default,Euphemina,0,0,0,,Düşündüğüm kadar iyi değil.
Dialogue: 0,0:15:22.85,0:15:26.27,Default,Adventurers,0,0,0,,Çılgın Spiral!
Dialogue: 0,0:15:28.17,0:15:29.74,Default,Euphemina,0,0,0,,Fena değil.
Dialogue: 0,0:15:33.17,0:15:34.54,Default,Euphemina,0,0,0,,{\i1}Beceri Kopyalama.
Dialogue: 0,0:15:44.39,0:15:46.25,Default,System,0,0,0,,{\i1}Beceri Kopyalama işleminiz başarılı oldu.
Dialogue: 0,0:15:46.25,0:15:50.26,screen_text,sign,0,0,0,,{\fs45\c&HEAE5E3&\3c&H786F69&\pos(650,319.5)}Çılgın Spiral
Dialogue: 0,0:15:46.25,0:15:50.26,screen_text,sign,0,0,0,,{\fs45\c&HEAE5E3&\3c&H777576&\pos(1256,319.5)}Kullanım Alanları
Dialogue: 0,0:15:46.25,0:15:50.26,screen_text,sign,0,0,0,,{\an1\fs30\b0\pos(378,510)\3c&H736B66&}5 saniye boyunca bir spiral oluşturur.
Dialogue: 0,0:15:46.25,0:15:50.26,screen_text,sign,0,0,0,,{\an1\fs30\b0\pos(378,615)\3c&H736B66&}Yarıçapı içindeki düşmanlara saniye başına\N1.530-2.380 hasar verir. Çeviklik %80 azalır.
Dialogue: 0,0:15:46.25,0:15:50.26,screen_text,sign,0,0,0,,{\an1\fs30\b0\pos(378,783)\3c&H736B66&}Bu beceri, Beceri Kopyalama ile\Nkopyalanmıştır. Kullanana kadar saklanabilir.
Dialogue: 0,0:15:47.24,0:15:49.70,Default,System,0,0,0,,{\i1}Bu beceriyi bir kez kullanabilirsiniz.
Dialogue: 0,0:15:51.51,0:15:53.98,Default,Euphemina,0,0,0,,{\i1}İşte epik bir mesleğin gücü budur.
Dialogue: 0,0:15:57.11,0:15:59.92,Default,Adventurers,0,0,0,,Ee? Artık partimize\Nkatılacak mısın...
Dialogue: 0,0:16:00.57,0:16:02.51,Default,Adventurers,0,0,0,,Euphemina-san?
Dialogue: 1,0:16:03.27,0:16:07.27,screen_text,sign,0,0,0,,{\c&HD8D2CF&\b0\bord1\3c&H514843&\blur1.5\fs30\an8\pos(1404.4,30)}Görev {\b1}Hain Kırmızı Şövalyeyi Mahkûm Et (S){\b0} Sahara İmparatorluğu’nun Kırmızı Şövalyeleri, kıtanın en güçlü şövalyeleridir. Eski şövalye komutanı Piaro, şu anki şövalye\Nkomutanı Asmophel’e ihanet edip onu ağır şekilde yaraladıktan sonra, Kesan Kanyonu’nda saklanıyor. Asmophel, intikamını almanı istedi. Koşul: Piaro’yu bul ve cezalandır
Dialogue: 0,0:16:03.27,0:16:07.27,screen_text,sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 600 0 600 156 0 156
Dialogue: 0,0:16:03.88,0:16:06.79,Default,Euphemina,0,0,0,,Kızıl Şövalye Hainini (S) yargıla.
Dialogue: 0,0:16:07.27,0:16:10.47,Default,Euphemina,0,0,0,,Eski şövalye komutanı\N Piaro’yu bul ve yargıla.
Dialogue: 0,0:16:11.53,0:16:14.78,Default,Euphemina,0,0,0,,Sanırım bu S-sınıfı\Ngörevi üstlenebileceğim.
Dialogue: 0,0:16:16.92,0:16:18.62,Default,Euphemina,0,0,0,,Ne istiyorsun {\i1}sen{\i0}?
Dialogue: 0,0:16:18.84,0:16:21.57,Default,Euphemina,0,0,0,,Bana çok uzaktan bakıyordun, değil mi?
Dialogue: 0,0:16:22.56,0:16:25.33,Default,Rabbit,0,0,0,,Beni hatırlamıyor musun?
Dialogue: 0,0:16:26.40,0:16:28.38,Default,Euphemina,0,0,0,,Seninle randevuya çıkmayacağım.
Dialogue: 0,0:16:28.38,0:16:31.01,Default,Rabbit,0,0,0,,Erina adını hatırlıyor musun?
Dialogue: 0,0:16:31.97,0:16:37.36,Default,Rabbit,0,0,0,,Mero Şirketi tarafından olağanüstü\Nyetenekleri nedeniyle işe alınmıştı,
Dialogue: 0,0:16:37.36,0:16:40.16,Default,Rabbit,0,0,0,,ama avansı aldıktan sonra ortadan kayboldu.
Dialogue: 0,0:16:40.16,0:16:43.23,Default,Rabbit,0,0,0,,Bir demirci... hayır.
Dialogue: 0,0:16:43.64,0:16:46.48,Default,Rabbit,0,0,0,,Çoğaltıcı Euphemina.
Dialogue: 0,0:16:50.23,0:16:53.43,Default,Euphemina,0,0,0,,Kullanıcıların hiçbiri henüz bilmiyor.
Dialogue: 0,0:16:53.43,0:16:55.56,Default,Euphemina,0,0,0,,Sen biliyorsun çünkü bir NPC’sin, değil mi?
Dialogue: 0,0:16:56.09,0:16:58.75,Default,Rabbit,0,0,0,,Buna cevap veremem.
Dialogue: 0,0:16:59.34,0:17:02.09,Default,Rabbit,0,0,0,,Ama merak ediyorum bu kadar acelen ne?
Dialogue: 0,0:17:03.43,0:17:07.33,Default,Euphemina,0,0,0,,Aslında zorlu bir görevle uğraşıyorum.
Dialogue: 0,0:17:07.84,0:17:10.74,Default,Euphemina,0,0,0,,Sahra İmparatorluğu’nun\Nen güçlü şövalyesi, Piaro.
Dialogue: 0,0:17:11.34,0:17:14.07,Default,Euphemina,0,0,0,,Onu yenmem gerekiyor.
Dialogue: 0,0:17:15.82,0:17:19.26,Default,Rabbit,0,0,0,,Üzgünüm ama bu görevi\Nbırakmak zorunda kalacaksın.
Dialogue: 0,0:17:19.26,0:17:20.19,Default,Euphemina,0,0,0,,Ne?
Dialogue: 0,0:17:20.19,0:17:23.14,Default,Rabbit,0,0,0,,Başka bir görevde yardımını istiyorum.
Dialogue: 0,0:17:24.10,0:17:26.35,screen_text,sign,0,0,0,,{\bord1.5\b0\fs54\c&HDDD6D0&\3c&H655245&\frx22\fry12\pos(1030,282)\frz358.4}Görev
Dialogue: 0,0:17:24.10,0:17:26.35,screen_text,sign,0,0,0,,{\bord1.5\b1\fs84\c&HF7F6F5&\3c&H5B5755&\pos(1064,532)\frz0.6029\frx8\fry10}Eşya Oluşturma Maçı (Bilinmiyor)
Dialogue: 0,0:17:24.88,0:17:26.35,Default,Euphemina,0,0,0,,Zorluk seviyesi bilinmiyor mu?
Dialogue: 0,0:17:26.35,0:17:27.49,Default,Rabbit,0,0,0,,Doğru.
Dialogue: 0,0:17:27.49,0:17:29.81,Default,Euphemina,0,0,0,,Sen bir NPC'sin ve beni\Nmi tehdit ediyorsun?
Dialogue: 0,0:17:29.81,0:17:34.62,Default,Rabbit,0,0,0,,Ama bu koşullar\Nsenin için iyi, değil mi?
Dialogue: 1,0:17:32.11,0:17:34.99,screen_text,sign,0,0,0,,{\c&HD8D2CF&\b0\bord1\3c&H514843&\blur0.5\fs35\an8\pos(1040,18.8)}Koşul: Eşya Oluşturma Maçını Kazan\Nödül: 1.500 altın\NUnvan: “Oyun Ustası”\N{\c&H3415B2&} Oyun Ustası: İstatistikler “Mücadele Ruhu” ‘Şans’\N{\c&HD8D2CF&}Beceri “Zarı At”...
Dialogue: 0,0:17:32.11,0:17:34.99,screen_text,sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 600 0 600 69 0 69
Dialogue: 0,0:17:39.38,0:17:40.95,Default,Grid,0,0,0,,Huroi tutuklandı mı?
Dialogue: 0,0:17:40.95,0:17:41.99,Default,Kahn,0,0,0,,Evet.
Dialogue: 0,0:17:41.99,0:17:44.95,Default,Kahn,0,0,0,,Kont Steim’e karşı\Nvatana ihanet şüphesiyle.
Dialogue: 0,0:17:44.95,0:17:48.58,Default,Kahn,0,0,0,,Şu anda kalenin yeraltı\Nzindanında tutuluyor.
Dialogue: 0,0:17:49.31,0:17:51.09,Default,Grid,0,0,0,,Bu...
Dialogue: 0,0:17:51.09,0:17:55.29,Default,Kahn,0,0,0,,Evet, görünüşe göre Mero\NŞirketi’nde akıllı biri çalışıyor.
Dialogue: 0,0:18:00.60,0:18:02.14,Default,Rabbit,0,0,0,,Affedersiniz.
Dialogue: 0,0:18:02.14,0:18:05.10,Default,Rabbit,0,0,0,,Ben Mero Şirketi’nden Rabbit.
Dialogue: 0,0:18:05.61,0:18:08.87,Default,Rabbit,0,0,0,,Efendim Valmont adına geldim.
Dialogue: 0,0:18:12.86,0:18:17.75,Default,Kahn,0,0,0,,Yani, Huroi’yi kurtarmak istiyorsak,\Nteklifinizi kabul etmemiz mi gerekiyor?
Dialogue: 0,0:18:18.11,0:18:19.82,Default,Rabbit,0,0,0,,Doğru.
Dialogue: 0,0:18:19.89,0:18:21.13,Default,Grid,0,0,0,,Ha! Sanki olur da.
Dialogue: 0,0:18:21.13,0:18:23.12,Default,Grid,0,0,0,,O adama ne olacağı umurumda değil.
Dialogue: 0,0:18:23.45,0:18:25.67,Default,Rabbit,0,0,0,,Ne kadar kalpsizsin.
Dialogue: 0,0:18:25.67,0:18:29.85,Default,Rabbit,0,0,0,,Sebepleri ne olursa olsun,\Nköylüleri korumaya çalıştı.
Dialogue: 0,0:18:30.91,0:18:33.76,Default,Rabbit,0,0,0,,Tehlikeye aldırmadan,
Dialogue: 0,0:18:33.76,0:18:36.05,Default,Rabbit,0,0,0,,onu öylece terk mi edeceksin?
Dialogue: 0,0:18:38.46,0:18:43.01,Default,Rabbit,0,0,0,,Elbette, sırf onun özgürlüğü için demirci\Ndükkanını teslim etmeni istemiyorum.
Dialogue: 0,0:18:44.80,0:18:48.73,Default,Rabbit,0,0,0,,Bizimle bir eşya yapım\Nyarışması yapmanı istiyorum.
Dialogue: 0,0:18:48.73,0:18:49.72,Default,Kahn,0,0,0,,Ne?
Dialogue: 0,0:18:49.72,0:18:54.14,Default,Rabbit,0,0,0,,Kazanırsan, demirci\Ndükkanından vazgeçeceğiz.
Dialogue: 0,0:18:54.14,0:18:56.54,Default,Rabbit,0,0,0,,Ve Huroi’yi serbest bırakacağız.
Dialogue: 0,0:18:57.82,0:18:58.96,Default,Kahn,0,0,0,,Peki.
Dialogue: 0,0:18:59.32,0:19:02.49,Default,Kahn,0,0,0,,Ama ben katılmayacağım.\NYarışmaya Pagma’nın halefi...
Dialogue: 0,0:19:02.77,0:19:05.49,Default,Kahn,0,0,0,,Pagma'nın Halefi.
Dialogue: 0,0:19:06.24,0:19:07.75,Default,Rabbit,0,0,0,,Pagma'nın Halefi mi?
Dialogue: 0,0:19:07.75,0:19:09.25,Default,Kahn,0,0,0,,Grid burada.
Dialogue: 0,0:19:09.25,0:19:12.29,Default,Grid,0,0,0,,Hey! Kim sana izin verdi ki—
Dialogue: 0,0:19:10.73,0:19:12.29,Default,System,0,0,0,,{\i1}Sistem rehberi.
Dialogue: 0,0:19:12.29,0:19:16.96,Default,System,0,0,0,,{\i1}"Mero Şirketi ile Eşya Üretim\NYarışması" görevi oluşturuldu.
Dialogue: 0,0:19:16.96,0:19:19.91,Default,Grid,0,0,0,,600 altın mı?!
Dialogue: 0,0:19:18.33,0:19:19.71,Default,System,0,0,0,,{\i1}Kabul ediyor musun?
Dialogue: 0,0:19:21.97,0:19:23.50,Default,System,0,0,0,,{\i1}Görev kabul edildi.
Dialogue: 0,0:19:23.50,0:19:26.89,Default,Grid,0,0,0,,Gel de yakala beni, dört gözlü tuhaf herif!
Dialogue: 0,0:19:26.89,0:19:28.41,Default,Rabbit,0,0,0,,Elbette.
Dialogue: 0,0:19:28.41,0:19:34.15,Default,Rabbit,0,0,0,,Pagma’nın Halefi olduğun konusunda\Nyalan söylediğini kanıtlayacağım.
Dialogue: 1,0:19:34.15,0:19:41.15,screen_text,sign,0,0,0,,{\c&HD8D2CF&\b0\bord1\3c&H514843&\blur0.5\fs26\an8\pos(1580,35.667)} Görev\N{\b1}Eşya Üretim Maçı\NMero Şirketi ile (Bilinmiyor){\b0}\N\N\NMero Şirketi sana\Ndemirhanede bir savaşa davet etti.\NKahn'ın durumu pek iyi değil ve senin\Nkendisi yerine katılmanı istedi.\N\N\NBaşarı Koşulu: Mero Şirketi’yle yapılan karşılaşmayı kazan\NBaşarı Ödülü: 600 altın ödül\N+Winston’da 500 şöhret\N\NBaşarısızlık: Winston’daki şöhret 1 olur.\NKahn, demirhanesini Mero Şirketi’ne kaybeder.
Dialogue: 0,0:19:34.15,0:19:41.15,screen_text,sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 600 0 600 186 0 186
Dialogue: 0,0:19:34.39,0:19:37.38,Default,Rabbit,0,0,0,,Müsabaka üç gün sonra\Nyapılacak. Bu senin için uygun mu?
Dialogue: 1,0:19:36.56,0:19:38.44,Default,Grid,0,0,0,,{\an8}Evet, seni fena halde pataklayacağım!
Dialogue: 0,0:19:38.44,0:19:41.15,Default,Grid,0,0,0,,O 72.000 yen benim olacak!
Dialogue: 0,0:19:44.41,0:19:48.91,screen_text,sign,0,0,0,,{\b0\fs45\bord1.5\c&HCDC6C1&\3c&H6C5B50&\pos(970,148)}Görev
Dialogue: 0,0:19:44.41,0:19:48.91,screen_text,sign,0,0,0,,{\b1\fs45\bord1\c&HF0F0F0&\3c&H69625D&\pos(898,330)}Bekleme
Dialogue: 0,0:19:44.41,0:19:48.91,screen_text,sign,0,0,0,,{\b1\fs36\bord1\c&HF0F0F0&\3c&H635B55&\pos(972,378)}Kalan Süre
Dialogue: 0,0:19:49.21,0:19:51.88,Default,Huroi,0,0,0,,Sonunda... yolun\Nyarısına geldim...
Dialogue: 0,0:19:55.05,0:19:56.79,Default,Huroi,0,0,0,,Bunu başaracağım.
Dialogue: 0,0:19:57.29,0:20:00.50,Default,Huroi,0,0,0,,Pes etmeyeceğim...\Nne olursa olsun...
Dialogue: 0,0:20:02.91,0:20:04.32,Default,Grid,0,0,0,,{\i1}Beni küçümseme!
Dialogue: 0,0:20:04.32,0:20:07.06,Default,Grid,0,0,0,,{\i1}Ben efsanevi demirciyim!
Dialogue: 0,0:20:07.56,0:20:11.27,Default,Grid,0,0,0,,{\i1}Size efsanevi bir mesleğin neler\Nyapabileceğini göstereceğim!
Dialogue: 0,0:20:15.27,0:20:17.37,Default,Judge,0,0,0,,Herkese merhaba!
Dialogue: 0,0:20:17.37,0:20:24.78,Default,Judge,0,0,0,,Mero Şirketi’nin Eşya Maçı etkinliği\Niçin bir araya geldiğiniz için teşekkürler!
Dialogue: 0,0:20:26.78,0:20:30.79,Default,Judge,0,0,0,,Şimdi, iki yarışmacımızı tanıtalım!
Dialogue: 0,0:20:31.06,0:20:33.20,Default,Valmont,0,0,0,,Bunu gerçekten kazanabiliriz, değil mi?
Dialogue: 0,0:20:33.20,0:20:34.42,Default,Rabbit,0,0,0,,Elbette.
Dialogue: 0,0:20:35.13,0:20:38.17,Default,Judge,0,0,0,,Kahn’ın demirhanesinden... Grid!
Dialogue: 0,0:20:38.17,0:20:39.66,Default,Villagers,0,0,0,,Başarabilirsin, Grid!
Dialogue: 0,0:20:39.66,0:20:41.17,Default,Villagers,0,0,0,,Demirci dükkanını koru!
Dialogue: 0,0:20:41.64,0:20:44.46,Default,Judge,0,0,0,,Mero Şirketi'nden... Erina!
Dialogue: 0,0:20:48.05,0:20:50.45,Default,Euphemina,0,0,0,,Destekleriniz için teşekkürler, millet!
Dialogue: 0,0:20:54.81,0:21:00.28,Default,Crowd,0,0,0,,{\an8}Erina! Erina! Erina!
Dialogue: 0,0:20:58.81,0:20:59.77,Default,Grid,0,0,0,,Canın cehenneme!
Dialogue: 0,0:21:01.27,0:21:05.78,Default,Sakeda,0,0,0,,Bu turnuva, Huroi'nin\Nkaderini belirleyecek.
Dialogue: 0,0:21:06.29,0:21:09.84,Default,Sakeda,0,0,0,,Hinako-kun, {\i1}Satisfy{\i0}’nin Moğolistan\Nşubesiyle iletişim halinde miyiz?
Dialogue: 0,0:21:10.19,0:21:10.79,Default,Hinako,0,0,0,,Evet.
Dialogue: 0,0:21:11.29,0:21:15.79,Default,Hinako,0,0,0,,Yerel personel hazır bekliyor,\Ngerekirse Huroi’yi yakalamaya hazırlar.
Dialogue: 0,0:21:17.53,0:21:20.87,Default,Sakeda,0,0,0,,Şimdi, B408 Görevi—yani,
Dialogue: 0,0:21:18.29,0:21:24.61,screen_text,sign,0,0,0,,{\blur0.8\bord0\b1\fs30\c&HB7B5B5&\pos(1500,774)}Kalan Süre
Dialogue: 0,0:21:20.87,0:21:24.61,Default,Sakeda,0,0,0,,{\i1}Satisfy{\i0}'nin tarihindeki ilk\Nikinci işi, ortaya çıkacak...
Dialogue: 0,0:21:25.45,0:21:27.58,Default,Sakeda,0,0,0,,{\i1}her şey Grid'e bağlı.
Dialogue: 0,0:21:28.00,0:21:29.28,Default,Euphemina,0,0,0,,Grid-san!
Dialogue: 0,0:21:30.32,0:21:32.44,Default,Euphemina,0,0,0,,Tanıştığımıza memnun oldum!
Dialogue: 0,0:21:33.37,0:21:35.56,Default,Grid,0,0,0,,Bana bu kadar samimi davranma, velet.
Dialogue: 0,0:21:36.58,0:21:39.18,Default,Euphemina,0,0,0,,On dokuz yaşındayım.
Dialogue: 0,0:21:39.18,0:21:40.90,Default,Euphemina,0,0,0,,Çocuk değilim!
Dialogue: 0,0:21:40.90,0:21:43.78,Default,Grid,0,0,0,,Eh, sen benden daha çok çocuksun!
Dialogue: 0,0:21:43.78,0:21:44.90,Default,Euphemina,0,0,0,,Gerçekten sinir bozucusun.
Dialogue: 0,0:21:44.90,0:21:46.36,Default,Grid,0,0,0,,Hayır, sen öylesin, cüce!
Dialogue: 0,0:21:51.46,0:21:53.75,Default,Judge,0,0,0,,B-Bekleyin, ikiniz de!
Dialogue: 0,0:21:55.03,0:21:56.25,Default,Judge,0,0,0,,Şimdi...
Dialogue: 0,0:21:56.25,0:21:58.35,Default,Judge,0,0,0,,Maç başlasın!
