Dialogue: 0,0:00:00.00,0:00:03.00,Default,,0,0,0,,{\fs50\an7\fe162\b\fad(400,400)\bord2\blur5\shad\4c&H000000&\4a&HFF&\fnSweetest Cat Ever\pos(10.4,-16.4)}\N{\pos(20,-2)}{\c&HFFFF00&}{\4c&H8485E4&}SomeSub ekip arkadaşı arıyor!\N{\pos(60,63)}{\c&HFFFFFF&}Çevirmen:{\c&HFFFF00&} Künefe-Kun\N{\pos(60,111)}{\c&HFFFFFF&}Encode:{\c&HFFFF00&} AJAN\N{\pos(60,111)}{\c&HFFFFFF&}Redaktör:{\c&HFFFF00&} AJAN\N{\c&HFFFFFF&}Discord:{\c&HFFFF00&} discord.gg/somesub
Dialogue: 0,0:00:01.17,0:00:02.30,Default,MC,0,0,0,,{\i1}Satisfy{\i0},
Dialogue: 0,0:00:02.78,0:00:06.25,Default,MC,0,0,0,,genellikle “başka bir Dünya” olarak anılan \Nbir sanal gerçeklik oyunu.
Dialogue: 0,0:00:07.70,0:00:11.14,Default,MC,0,0,0,,Bugün, konuklarımızla her mesleği özel,
Dialogue: 0,0:00:11.14,0:00:15.70,Default,MC,0,0,0,,kılan unsurlar ve sınıfların\Nönemi hakkında konuşacağız.
Dialogue: 0,0:00:16.07,0:00:22.67,Default,MC,0,0,0,,Söylenene göre, sınıfınızın {\i1}Satisfy{\i0}’daki\Ngücünüz üzerinde büyük bir etkisi var.
Dialogue: 0,0:00:22.67,0:00:26.00,Default,MC,0,0,0,,Ne düşünüyorsunuz, Yura-san?
Dialogue: 0,0:00:26.25,0:00:27.57,Default,Yura,0,0,0,,Bu doğru.
Dialogue: 0,0:00:27.93,0:00:31.73,Default,Yura,0,0,0,,{\an8}Bazı mesleklerin\Nkesinlikle avantajları var.
Dialogue: 0,0:00:29.48,0:00:35.01,screen_text,sign,0,0,0,,{\b1\bord1\c&HF0F0F0&\3c&H1B0F0E&\pos(368.7,752.7)}Yura
Dialogue: 1,0:00:29.48,0:00:35.01,screen_text,sign,0,0,0,,{\an4\bord0\b1\fs30\c&HD4CABE&\pos(150.9,900.3)}Kara Büyücü
Dialogue: 1,0:00:29.48,0:00:35.01,screen_text,sign,0,0,0,,{\an4\bord0\b1\fs27\c&HD4CABE&\pos(149.3,949.3)}Toplam Rütbe: 5
Dialogue: 0,0:00:29.48,0:00:35.01,screen_text,sign,0,0,0,,{\blur6\an7\bord0\p1\fscy220\alpha&H0&\c&H20160B&\pos(144,872)}m 0 0 l 240 0 240 24 0 24
Dialogue: 0,0:00:29.48,0:00:35.01,screen_text,sign,0,0,0,,{\blur6\an7\bord0\p1\fscy220\alpha&H0&\c&H20160B&\pos(144,926)}m 0 0 l 285 0 285 24 0 24
Dialogue: 0,0:00:31.73,0:00:35.01,Default,Yura,0,0,0,,{\an8}Ama bir meslekte ustalaşmak da önemlidir.
Dialogue: 0,0:00:35.93,0:00:41.12,Default,Roy,0,0,0,,{\an8}Öyle diyorsun ama aslında özel sınıf\Nmesleklerine sahip insanları kıskanıyorsun.
Dialogue: 0,0:00:38.28,0:00:43.14,screen_text,sign,0,0,0,,{\b1\bord1\c&HF0F0F0&\3c&H1B0F0E&\pos(360.7,752.7)}Roy
Dialogue: 1,0:00:38.28,0:00:43.14,screen_text,sign,0,0,0,,{\an4\bord0\b1\fs30\c&HD4CABE&\pos(149.3,898.7)}Kan Savaşçısı
Dialogue: 1,0:00:38.28,0:00:43.14,screen_text,sign,0,0,0,,{\an4\bord0\b1\fs27\c&HD4CABE&\pos(149.3,949.3)}Toplam Sıra: 53
Dialogue: 0,0:00:38.28,0:00:43.14,screen_text,sign,0,0,0,,{\blur6\an7\bord0\p1\fscy220\alpha&H0&\c&H20160B&\pos(144,872)}m 0 0 l 435 0 435 24 0 24
Dialogue: 0,0:00:38.28,0:00:43.14,screen_text,sign,0,0,0,,{\blur6\an7\bord0\p1\fscy220\alpha&H0&\c&H20160B&\pos(144,926)}m 0 0 l 300 0 300 24 0 24
Dialogue: 0,0:00:41.12,0:00:44.31,Default,Roy,0,0,0,,{\an8}Sen sadece bir Kara Büyücüsün.
Dialogue: 0,0:00:44.31,0:00:47.01,Default,Roy,0,0,0,,Bu oyunda, nadir olan\Nnormal olandan üstündür.
Dialogue: 0,0:00:47.01,0:00:49.16,Default,Roy,0,0,0,,Ve epik olan da nadir olandan üstündür!
Dialogue: 0,0:00:49.16,0:00:51.40,Default,Roy,0,0,0,,Her şey, değerlerinin ne\Nkadar yüksek olduğuna bağlı.
Dialogue: 0,0:00:51.86,0:00:53.55,Default,Roy,0,0,0,,Kanıt olarak...
Dialogue: 0,0:00:55.15,0:00:56.98,Default,MC,0,0,0,,O-Onun kılıcı!
Dialogue: 0,0:00:58.87,0:01:04.63,Default,Roy,0,0,0,,Epik sınıfa geçtiğimde bir\Nkeresinde ilk 100’e fırladım.
Dialogue: 0,0:01:05.92,0:01:08.89,Default,Yura,0,0,0,,Bir Kan Savaşçısının özel yeteneği
Dialogue: 0,0:01:08.89,0:01:11.92,Default,Yura,0,0,0,,pasif bir yetenek\Nolarak rakibinin HP'sini emmektir.
Dialogue: 0,0:01:11.92,0:01:14.34,Default,Roy,0,0,0,,Öyle mi? Bunu biliyor musun?
Dialogue: 0,0:01:14.34,0:01:17.67,Default,Yura,0,0,0,,Yani sen temelde mesleğine\Ngüveniyorsun, öyle mi?
Dialogue: 0,0:01:17.67,0:01:19.47,Default,Yura,0,0,0,,Tıpkı senin eşyalarına güvendiğin gibi mi?
Dialogue: 0,0:01:19.47,0:01:20.89,Default,Roy,0,0,0,,Ne dedin?
Dialogue: 0,0:01:20.89,0:01:26.54,Default,MC,0,0,0,,Ş-Şu anda {\i1}Satisfy{\i0}'da üç epik\Nmeslek olduğu söyleniyor.
Dialogue: 0,0:01:26.54,0:01:30.26,Default,MC,0,0,0,,Bunlardan biri Roy-san’ın\Nmesleği olan Kan Savaşçısı.
Dialogue: 0,0:01:30.26,0:01:34.57,Default,MC,0,0,0,,İkincisi ise 7. sıradaki oyuncu\NAgnus’un kullandığı meslek,
Dialogue: 0,0:01:34.57,0:01:37.16,Default,MC,0,0,0,,ama kendisi ayrıntıların\Ngizli tutulmasını istedi.
Dialogue: 0,0:01:37.16,0:01:42.72,Default,MC,0,0,0,,Üçüncüsüne gelince... Kim\Nolabileceğine dair hiçbir bilgi yok!
Dialogue: 0,0:01:42.72,0:01:45.41,Default,MC,0,0,0,,Elbette, savaşmaya dayalı olmayan
Dialogue: 0,0:01:45.41,0:01:48.92,Default,MC,0,0,0,,nadir ve sıradan mesleklerin de\Nolduğu söyleniyor...
Dialogue: 0,0:01:48.92,0:01:55.59,Default,MC,0,0,0,,Peki hangi kullanıcılar ve hangi meslekler,\N{\i1}Satisfy{\i0}’ın tarihini sonsuza dek değiştirecek?
Dialogue: 0,0:01:55.59,0:01:58.46,Default,MC,0,0,0,,Bekleyip göreceğiz!
Dialogue: 0,0:02:20.26,0:02:21.79,sign_generic,sign,0,0,0,,{\fad(51,0)\bord3\blur6\an1\fs51\b1\fnGeorgia\c&H095DF8&\3c&HBFBEC1&\t(0,1469,\fs16)\move(1098,762,1078,746,0,1450)}O{\c&H0A27EB&}v{\c&H1828CE&}e{\c&H1026F3&\}r{\c&H1705C3&}g{\c&H1306A0&}e{\c&H0F028F&}a{\c&H090544&}r{\c&H211D2F&}e{\c&H000000&}d
Dialogue: 0,0:02:21.79,0:02:25.02,sign_generic,sign,0,0,0,,{\fad(0,1080)\bord3\blur6\an1\fs48\b1\fnGeorgia\c&H095DF8&\3c&HBFBEC1&\t(0,273,\3c&HFEFEFE&)\t(0,273,\c&H252525&)\pos(1078,746)}O{\c&H0A27EB&\t(0,273,\c&H666767&)}v{\c&H1828CE&\t(0,273,\c&H363636&)}e{\c&H1026F3&\t(0,273,\c&H7E7E7E&)}r{\c&H1705C3&\t(0,273,\c&H5E5E5E&)}g{\c&H1306A0&\t(0,273,\c&H252525&)}e{\c&H0F028F&\t(0,273,\c&H666767&)}a{\c&H090544&\t(0,273,\c&H363636&)}r{\c&H211D2F&\t(0,273,\c&H7E7E7E&)}e{\c&H000000&\t(0,273,\c&H5E5E5E&)}d
Dialogue: 0,0:03:31.48,0:03:34.29,Default,Takumi,0,0,0,,Hastaneden bu kadar çabuk\N taburcu olmana sevindim.
Dialogue: 0,0:03:34.29,0:03:39.74,Default,Kahn,0,0,0,,Evet. Hâlâ senin gibi genç çocuklar\Nvarsa, bu dünya o kadar da kötü değil.
Dialogue: 0,0:03:39.74,0:03:43.28,Default,Takumi,0,0,0,,Ben olmasaydım, \Ndoktora bile gidemezdin.
Dialogue: 0,0:03:43.28,0:03:44.69,Default,Kahn,0,0,0,,Evet.
Dialogue: 0,0:03:44.69,0:03:49.08,Default,Takumi,0,0,0,,Tabii ki, sana yardım ettikten sonra,\Nbunu bana vermek istiyorsun, değil mi?
Dialogue: 0,0:03:49.08,0:03:50.40,Default,Kahn,0,0,0,,Evet.
Dialogue: 0,0:03:52.54,0:03:54.89,Default,Kahn,0,0,0,,B-Bekle. İşte bu, sana\Nveremeyeceğim tek şey.
Dialogue: 0,0:03:54.89,0:03:55.96,Default,Takumi,0,0,0,,Ne?!
Dialogue: 0,0:03:55.96,0:03:57.74,Default,Takumi,0,0,0,,Ama hayatını kurtardım!
Dialogue: 0,0:03:57.74,0:04:00.36,Default,Takumi,0,0,0,,Ben olmasaydım ölürdün!
Dialogue: 0,0:04:00.36,0:04:01.70,Default,Kahn,0,0,0,,Lütfen beni anla.
Dialogue: 0,0:04:01.70,0:04:04.72,Default,Kahn,0,0,0,,O, nesiller boyu aktarılan\Nbir aile hazinesidir.
Dialogue: 0,0:04:04.95,0:04:06.26,Default,Takumi,0,0,0,,Aile hazinesi mi?
Dialogue: 0,0:04:06.58,0:04:11.77,Default,Kahn,0,0,0,,Dainsleif ve Valhalla\Natalarım tarafından yapılmıştı.
Dialogue: 0,0:04:11.77,0:04:16.52,Default,Kahn,0,0,0,,Yıllardır kimse onların\Ngücünü ortaya çıkaramamıştı.
Dialogue: 0,0:04:16.94,0:04:21.37,Default,Kahn,0,0,0,,Ancak 130 yıl önce, bir adam ortaya çıktı.
Dialogue: 0,0:04:21.37,0:04:22.96,Default,Kahn,0,0,0,,Adı Pagma’ydı.
Dialogue: 0,0:04:23.35,0:04:26.86,Default,Kahn,0,0,0,,O, sadece \Nonların yeteneklerini anlamakla kalmadı,
Dialogue: 0,0:04:26.86,0:04:29.77,Default,Kahn,0,0,0,,aynı zamanda onlarla\Nmuhteşem bir dans sergiledi.
Dialogue: 0,0:04:29.77,0:04:33.32,Default,Kahn,0,0,0,,Ama onları almadan gitti.
Dialogue: 0,0:04:34.08,0:04:38.91,Default,Kahn,0,0,0,,Tek söylediği, onların gerçek\Nsahibinin bir gün ortaya çıkacağıydı.
Dialogue: 0,0:04:40.88,0:04:43.29,Default,Grid,0,0,0,,Hey! O ben olmalıyım!
Dialogue: 0,0:04:43.29,0:04:45.38,Default,Grid,0,0,0,,Ne de olsa ben Pagma'nın Halefiyim!
Dialogue: 0,0:04:47.09,0:04:48.36,Default,Kahn,0,0,0,,Evet...
Dialogue: 0,0:04:49.40,0:04:52.56,Default,Kahn,0,0,0,,Onları kullanabildin...
Dialogue: 0,0:04:54.11,0:04:58.02,Default,Kahn,0,0,0,,Ama gerçekten Pagma’nın Halefiysen,
Dialogue: 0,0:04:58.49,0:05:01.03,Default,Kahn,0,0,0,,efsanenin doğru olduğunu kanıtlamalısın.
Dialogue: 0,0:05:01.92,0:05:02.63,screen_text,sign,0,0,0,,{\b0\fs30\fad(88,88)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(956,398.7)}Meslek Görevi
Dialogue: 0,0:05:01.92,0:05:02.63,screen_text,sign,0,0,0,,{\b1\fs30\fad(88,88)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(961.3,464.7)}Pagma’nın Halefi
Dialogue: 0,0:05:01.92,0:05:02.63,screen_text,sign,0,0,0,,{\b1\fs30\fad(88,88)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(961.3,635)}oluşturuldu
Dialogue: 0,0:05:02.09,0:05:03.28,Default,System,0,0,0,,{\i1}Sistem rehberi.
Dialogue: 0,0:05:03.36,0:05:06.78,Default,System,0,0,0,,{\i1}Efsanevi bir meslek görevi oluşturuldu.
Dialogue: 0,0:05:06.78,0:05:08.57,Default,System,0,0,0,,{\i1}“Efsaneyi Kanıtla.”
Dialogue: 1,0:05:06.84,0:05:10.78,screen_text,sign,0,0,0,,{\b0\fad(467,0)\c&HD8D2CF&\bord1\3c&H161014&\blur1.5\fs27\an8\pos(1590,38)}Meslek Görevi\N{\b1}Efsaneyi Kanıtla{\b0}\N\NPagma’nın tüm efsanelerini,\NKılıç Dansı’nı ipucu olarak kullanarak topla.\NGörev ilerledikçe ayrıntılar güncellenecektir.\N\N\N{\c&H765FAF&}*Zaman sınırı yok\N*Efsanevi meslek görevi başladıktan sonra,\Nmeslek değiştirilemez\N\N\N{\c&HD8D2CF&}Tamamlama Koşulu: İlgili tüm görevleri tamamlayın.\NTamamlama Ödülü: Bilinmiyor\N{\c&H765FAF&}*Her görev tamamlandıktan sonra kazanılır.
Dialogue: 0,0:05:06.84,0:05:10.78,screen_text,sign,0,0,0,,{\fad(467,0)\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 600 0 600 174 0 174
Dialogue: 0,0:05:08.57,0:05:12.76,Default,System,0,0,0,,{\i1}Bu, efsanevi demirci Pagma'nın da dahil olduğu\Nbirden fazla bölümden oluşan bir görevdir.
Dialogue: 0,0:05:12.76,0:05:17.43,Default,System,0,0,0,,{\i1}Tüm bölümleri tamamladığınızda dünyayı\Ndeğiştirecek güce sahip olacaksınız.
Dialogue: 0,0:05:17.85,0:05:20.25,Default,Grid,0,0,0,,{\i1}Bu çılgın bir ödül...
Dialogue: 0,0:05:21.02,0:05:21.75,screen_text,sign,0,0,0,,{\b0\fs30\fad(88,1)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(956,396.7)}Meslek Görevi
Dialogue: 0,0:05:21.02,0:05:21.75,screen_text,sign,0,0,0,,{\b1\fs30\fad(88,1)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(959.3,466.7)}Pagma'nın Halefi
Dialogue: 0,0:05:21.02,0:05:21.75,screen_text,sign,0,0,0,,{\b1\fs30\fad(88,1)\c&HEFEDEB&\3c&H677150&\bord1.5\blur3\pos(955.3,633)}şimdi başlayacak
Dialogue: 0,0:05:21.27,0:05:24.58,Default,Grid,0,0,0,,{\i1}Yani bir gün bu kılıcı\Nve zırhı alacağım mı?
Dialogue: 0,0:05:24.58,0:05:26.26,Default,Grid,0,0,0,,{\i1}Öyleyse...
Dialogue: 0,0:05:26.26,0:05:28.08,Default,Grid,0,0,0,,{\i1}Onları hemen bana ver!
Dialogue: 0,0:05:28.08,0:05:30.51,Default,Kahn,0,0,0,,O acınası surat da neyin nesi?
Dialogue: 0,0:05:30.51,0:05:33.89,Default,Kahn,0,0,0,,Pagma’nın Halefi olduğun konusunda\Nyalan söylediğini anlamıştım.
Dialogue: 0,0:05:33.89,0:05:35.01,Default,Takumi,0,0,0,,Ne?!
Dialogue: 0,0:05:35.01,0:05:37.56,Default,Grid,0,0,0,,Peki o zaman! Sana yeteneğimi göstereceğim!
Dialogue: 0,0:05:37.56,0:05:39.63,Default,Grid,0,0,0,,Hadi artık bana demirci olmayı öğret!
Dialogue: 0,0:05:39.63,0:05:42.83,Default,Kahn,0,0,0,,Tanrım, ne kadar da acelecisin.
Dialogue: 0,0:05:43.28,0:05:46.44,Default,Kahn,0,0,0,,Önce demirci ocağını\Nyeniden inşa etmemiz gerekiyor.
Dialogue: 0,0:05:46.44,0:05:49.43,Default,Kahn,0,0,0,,Mero Şirketi geri gelebilir.
Dialogue: 0,0:05:53.41,0:05:54.66,Default,Valmont,0,0,0,,Rabbit...
Dialogue: 0,0:05:55.25,0:05:58.29,Default,Valmont,0,0,0,,Sanırım o demirci dükkanıyla\Nilgili işler yolunda gidiyor, değil mi?
Dialogue: 0,0:05:58.92,0:05:59.78,Default,Rabbit,0,0,0,,Evet.
Dialogue: 0,0:05:59.78,0:06:02.13,Default,Rabbit,0,0,0,,Her şey yerli yerinde.
Dialogue: 0,0:06:02.13,0:06:04.38,Default,Valmont,0,0,0,,Neden bu kadar uzun sürüyor?
Dialogue: 0,0:06:04.38,0:06:07.13,Default,Valmont,0,0,0,,Birkaç serseri topla\Nve orayı yerle bir et!
Dialogue: 0,0:06:07.13,0:06:10.94,Default,Rabbit,0,0,0,,Yerel Lord Earl Steim, bunu\Npek hoş karşılamayacaktır.
Dialogue: 0,0:06:10.94,0:06:14.92,Default,Rabbit,0,0,0,,Mero Şirketi’nin itibarını\Nzedelemekten kaçınmalıyız.
Dialogue: 0,0:06:16.07,0:06:17.25,Default,Valmont,0,0,0,,Neyse, ne olursa olsun.
Dialogue: 0,0:06:17.25,0:06:20.08,Default,Valmont,0,0,0,,Ee? İşe yarayacak, değil mi?
Dialogue: 0,0:06:21.58,0:06:23.90,Default,Rabbit,0,0,0,,Doğru adamı işe aldım.
Dialogue: 0,0:06:24.22,0:06:26.95,Default,Rabbit,0,0,0,,Altın dil sahibi bir adam.
Dialogue: 0,0:06:33.44,0:06:35.99,Default,Man,0,0,0,,Şu yeni gelen, Veil’in çetesini mi yendi?
Dialogue: 0,0:06:36.64,0:06:39.00,Default,Man,0,0,0,,Bana çocuk gibi görünüyor.
Dialogue: 0,0:06:39.00,0:06:41.49,Default,Kahn,0,0,0,,Hayır, etkileyici biri.
Dialogue: 0,0:06:41.49,0:06:43.72,Default,Kahn,0,0,0,,Gerçi aptal gibi görünüyor, kabul ediyorum.
Dialogue: 0,0:06:43.72,0:06:44.84,Default,Grid,0,0,0,,Hey!
Dialogue: 0,0:06:45.17,0:06:46.71,Default,Grid,0,0,0,,Seni duyabiliyorum!
Dialogue: 0,0:06:46.71,0:06:48.85,Default,Man,0,0,0,,Oh, bunu gördün mü?
Dialogue: 0,0:06:50.17,0:06:52.68,Default,Kahn,0,0,0,,Mero Şirketi'nin iş ilanı mı?
Dialogue: 0,0:06:52.68,0:06:56.82,Default,Man,0,0,0,,Yeni mağazalarında \Nbizi işe alacaklar.
Dialogue: 0,0:06:56.82,0:06:58.98,Default,Man,0,0,0,,Maaş düşündüğümden daha iyi ve...
Dialogue: 0,0:07:04.67,0:07:05.69,Default,Huroi,0,0,0,,Şey...
Dialogue: 0,0:07:06.20,0:07:07.31,Default,Huroi,0,0,0,,Mero Şirketi'nin
Dialogue: 0,0:07:07.31,0:07:10.86,Default,Huroi,0,0,0,,tüm işletmelerinizin haklarını\Npeyzoon bir fiyata satın aldığını duydum.
Dialogue: 0,0:07:11.19,0:07:13.37,Default,Huroi,0,0,0,,Seni bunu kabul etmeye zorladılar mı?
Dialogue: 0,0:07:13.90,0:07:16.87,Default,Grid,0,0,0,,{\i1}O da benim gibi bir oyuncu.
Dialogue: 0,0:07:16.87,0:07:18.75,Default,Man,0,0,0,,Kapa çeneni, yabancı!
Dialogue: 0,0:07:18.75,0:07:20.88,Default,Man,0,0,0,,Onlar için casusluk mu yapıyorsun?!
Dialogue: 0,0:07:20.88,0:07:23.82,Default,Huroi,0,0,0,,Hayır, hayır, ben senin tarafındayım.
Dialogue: 0,0:07:23.82,0:07:26.67,Default,Huroi,0,0,0,,Ama herkes işçi arıyor.
Dialogue: 0,0:07:27.02,0:07:30.09,Default,Huroi,0,0,0,,Eğer Mero Şirketi gibi büyük \Nbir yerde çalışsaydın,
Dialogue: 0,0:07:30.09,0:07:32.59,Default,Huroi,0,0,0,,para konusunda çok daha az endişen olurdu.
Dialogue: 0,0:07:33.01,0:07:34.34,Default,Man,0,0,0,,B-Bu...
Dialogue: 0,0:07:35.10,0:07:36.10,Default,Man,0,0,0,,O haklı!
Dialogue: 0,0:07:36.49,0:07:38.39,Default,Huroi,0,0,0,,Bu demirci dükkanında da durum aynı.
Dialogue: 0,0:07:38.75,0:07:41.27,Default,Huroi,0,0,0,,Mero Şirketi burayı devralsa bile,
Dialogue: 0,0:07:41.27,0:07:43.25,Default,Huroi,0,0,0,,sadece sahibi değişir.
Dialogue: 0,0:07:43.25,0:07:44.31,Default,Grid,0,0,0,,{\i1\an8}Bu...
Dialogue: 0,0:07:43.68,0:07:48.15,Default,Huroi,0,0,0,,Asıl işi yapanlar hâlâ sizler olduğunuz\Nsürece, kimse bir şey kaybetmez.
Dialogue: 0,0:07:45.61,0:07:46.94,Default,Grid,0,0,0,,{\i1\an8}Bu tuhaf his de ne?
Dialogue: 0,0:07:49.77,0:07:52.61,Default,Kahn,0,0,0,,Dışarıdan biri olarak, bu\Nkonuya oldukça ilgi göstermişsin.
Dialogue: 0,0:07:52.61,0:07:53.66,Default,Kahn,0,0,0,,Adın ne?
Dialogue: 0,0:07:54.63,0:07:55.42,Default,Huroi,0,0,0,,Huroi.
Dialogue: 0,0:07:55.83,0:07:57.41,Default,Huroi,0,0,0,,Adım Huroi.
Dialogue: 0,0:07:57.41,0:07:58.49,Default,Kahn,0,0,0,,Huroi.
Dialogue: 0,0:07:58.49,0:08:03.04,Default,Kahn,0,0,0,,Belki de haklısın, daha büyük bir\Nkuruluşla bir arada yaşamak iyi bir şeydir.
Dialogue: 0,0:08:03.04,0:08:06.29,Default,Kahn,0,0,0,,Ama bu köyde, köylü\Nhakları diye bir şey var.
Dialogue: 0,0:08:06.29,0:08:08.08,Default,Huroi,0,0,0,,Köylü hakları mı?
Dialogue: 0,0:08:08.08,0:08:12.63,Default,Kahn,0,0,0,,Efendimiz Kont Steim tarafından\Nbizim için oluşturulan bir yasa.
Dialogue: 0,0:08:12.85,0:08:14.77,Default,Kahn,0,0,0,,Yerel halkın,\Nbölgeyle ilgili bilgileri
Dialogue: 0,0:08:14.77,0:08:17.64,Default,Kahn,0,0,0,,herkesten daha önce\Nalma hakkı vardır.
Dialogue: 0,0:08:17.94,0:08:22.14,Default,Kahn,0,0,0,,Bize fayda sağlayabilecek her türlü\Nbilgiyi görmemiz garanti altındadır.
Dialogue: 0,0:08:22.39,0:08:26.19,Default,Kahn,0,0,0,,Kont, hayatlarımızı her\Nşeyden önce düşünür.
Dialogue: 0,0:08:26.65,0:08:31.57,Default,Kahn,0,0,0,,Ancak Mero Şirketi buraya gelip,\Ntüm bilgileri kendilerine saklamak için
Dialogue: 0,0:08:31.57,0:08:33.37,Default,Kahn,0,0,0,,lordun temsilcisiyle işbirliği yaptı.
Dialogue: 0,0:08:33.37,0:08:36.24,Default,Kahn,0,0,0,,Bu, kontun isteklerine aykırıdır.
Dialogue: 0,0:08:36.99,0:08:39.16,Default,Kahn,0,0,0,,Buna izin verilemez.
Dialogue: 0,0:08:40.40,0:08:41.90,Default,Huroi,0,0,0,,Anlıyorum.
Dialogue: 0,0:08:42.62,0:08:47.66,Default,Huroi,0,0,0,,O halde kontun yanına gidip şirketin\Nkötü davranışlarını ona anlatacağım!
Dialogue: 0,0:08:47.66,0:08:51.38,Default,Huroi,0,0,0,,Eğer söylediklerin doğru\Nçıkarsa, işler daha iyiye gider!
Dialogue: 0,0:08:51.38,0:08:53.58,Default,Man,0,0,0,,Bu... Bu harika olur!
Dialogue: 0,0:08:53.58,0:08:55.80,Default,Man,0,0,0,,Lütfen! Bize yardım et!
Dialogue: 0,0:08:55.80,0:08:59.55,Default,Kahn,0,0,0,,Hmm... Görünüşe göre\Nharika bir genç adamsın.
Dialogue: 0,0:09:00.39,0:09:01.78,Default,Grid,0,0,0,,{\i1}Biliyordum.
Dialogue: 0,0:09:02.24,0:09:05.14,Default,Grid,0,0,0,,{\i1}O bir oyuncu, ama
Dialogue: 0,0:09:05.87,0:09:10.17,Default,Grid,0,0,0,,{\i1}Bir görev mi oluşturdu ve\Nkendi başına değişiklikler mi yaptı?
Dialogue: 0,0:09:14.99,0:09:15.92,Default,Grid,0,0,0,,Hey!
Dialogue: 0,0:09:18.03,0:09:19.08,Default,Huroi,0,0,0,,Ne oldu?
Dialogue: 0,0:09:19.67,0:09:23.33,Default,Grid,0,0,0,,Başından beri açıkça\NMero Şirketi için çalışıyordun.
Dialogue: 0,0:09:23.57,0:09:25.90,Default,Grid,0,0,0,,Başka bir görev nasıl oluşturdun?
Dialogue: 0,0:09:26.34,0:09:29.04,Default,Huroi,0,0,0,,Oh, fark ettin, ha?
Dialogue: 0,0:09:29.04,0:09:30.71,Default,Grid,0,0,0,,Sadede gel!
Dialogue: 0,0:09:31.02,0:09:32.34,Default,Huroi,0,0,0,,Tamam, tamam.
Dialogue: 0,0:09:32.34,0:09:36.63,Default,Huroi,0,0,0,,Köylülere yardım edersem benden daha\Nfazla çıkar sağlayacağıma karar verdim
Dialogue: 0,0:09:36.63,0:09:39.14,Default,Huroi,0,0,0,,ve bu oyunun özgürlüğünden yararlandım.
Dialogue: 0,0:09:39.54,0:09:44.64,Default,Huroi,0,0,0,,NPC’lerin hayatlarına karışırsan,\Nbazen gizli bir görev tetiklenebilir.
Dialogue: 0,0:09:44.64,0:09:46.02,Default,Huroi,0,0,0,,Tıpkı böyle.
Dialogue: 0,0:09:46.41,0:09:48.13,Default,Huroi,0,0,0,,Görev bilgilerini paylaş.
Dialogue: 0,0:09:50.65,0:09:53.07,screen_text,sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H886754&}m 0 0 l 600 0 600 195 0 195
Dialogue: 1,0:09:50.65,0:09:53.07,screen_text,sign,0,0,0,,{\b0\c&HD8D2CF&\bord1\3c&H514843&\blur0.5\fs25\an8\pos(1590,45.667)}Gizli Görev\N {\b1}Winston Köylüleri İçin (A){\b0}\N\NKöylüleri ikna etmeye yönelik Mero Şirketi görevini\N bıraktın ve şirketin yaptıklarını Kont Steim'a\N anlatmak üzere başkent "Frontier"a gitmeye söz verdin.\N\NTamamlama Koşulu: Şirketin saldırılarını\N savuştur ve Kont Steim ile görüş.\N Tamamlama Ödülü: "Adalet Elçisi" unvanı\N Adalet Elçisi: "Cesaret" niteliği açılır.\NTüm nitelikler +10. "Sarsılmaz Adalet" becerisi kazanılır.\N {\c&H381EA1&}Başarısızlık: Mero Şirketi tarafından yakalanmak.\N\N{\c&HD8D2CF&}Seviye -1\N Yeni bir lord görevi devralana kadar Winston'a girişin yasaklanır.
Dialogue: 0,0:09:51.05,0:09:52.80,Default,Grid,0,0,0,,O-O ödül çılgınca!
Dialogue: 0,0:09:52.80,0:09:54.82,Default,Grid,0,0,0,,Bunu yapabileceğini bilmiyordum!
Dialogue: 0,0:09:55.87,0:09:57.80,Default,Huroi,0,0,0,,Tabii ki bilemezdin.
Dialogue: 0,0:09:57.80,0:10:01.11,Default,Huroi,0,0,0,,Sadece oyunun ilk\Nkullanıcıları bunu biliyor.
Dialogue: 0,0:10:01.11,0:10:04.49,Default,Grid,0,0,0,,Ha?! Ben de oyun çıktığında\Noynamaya başladım, biliyor musun!
Dialogue: 0,0:10:04.49,0:10:06.79,Default,Grid,0,0,0,,Bu lanet oyuna ne kadar\Npara harcadığımı biliyor musun?!
Dialogue: 0,0:10:08.62,0:10:09.87,Default,Huroi,0,0,0,,Çok komiksin!
Dialogue: 0,0:10:09.87,0:10:11.96,Default,Grid,0,0,0,,Kapa çeneni! Canın cehenneme!
Dialogue: 0,0:10:11.96,0:10:16.11,Default,Huroi,0,0,0,,Arkadaş olmak isterdim,\Nama şu anda yapmam gereken bir iş var.
Dialogue: 0,0:10:16.11,0:10:17.00,Default,Huroi,0,0,0,,Görüşürüz!
Dialogue: 0,0:10:17.51,0:10:18.95,Default,Grid,0,0,0,,Seni bir daha asla görmek istemiyorum!
Dialogue: 0,0:10:18.95,0:10:20.53,Default,Grid,0,0,0,,Defol git!
