Dialogue: 1,0:10:22.87,0:10:24.51,screen_text,sign,0,0,0,,{\fs54\fad(93,0)\c&HEEE8E3&\frz11.59\an7\pos(1013.3,538.7)}Nadirlik: Nadir
Dialogue: 1,0:10:22.87,0:10:24.51,screen_text,sign,0,0,0,,{\fs54\fad(93,0)\c&HEEE8E3&\frz11.59\an7\pos(1072,594.7)}Unvan: Yok
Dialogue: 0,0:10:26.20,0:10:29.29,Default,Huroi,0,0,0,,Ne pahasına olursa olsun\Nbu görevi tamamlayacağım!
Dialogue: 0,0:10:41.77,0:10:45.16,Default,Rabbit,0,0,0,,Earl Steim’i ziyaret ederek\Nzamanını boşa harcıyorsun.
Dialogue: 0,0:10:47.17,0:10:53.63,Default,Rabbit,0,0,0,,Senden Kahn’ı ve köylüleri ikna edip o\Ndemirci dükkânını almayı istememiş miydim?
Dialogue: 0,0:10:56.15,0:10:59.73,Default,Huroi,0,0,0,,Sadece onların isteğine\Nkatılıyormuş gibi yapıyordum.
Dialogue: 0,0:10:59.73,0:11:02.89,Default,Huroi,0,0,0,,Beyin yıkamanın bir parçası da insanların senin\Nyanında rahat hissetmelerini sağlamaktır, değil mi?
Dialogue: 0,0:11:03.82,0:11:06.14,Default,Rabbit,0,0,0,,Senin ağzından çıkan bu bahane çok zayıf.
Dialogue: 0,0:11:08.96,0:11:11.61,Default,Rabbit,0,0,0,,Hadi bu haini hapse atalım.
Dialogue: 0,0:11:11.98,0:11:14.25,Default,Rabbit,0,0,0,,Onu yeraltı zindanına götürün.
Dialogue: 0,0:11:20.34,0:11:22.33,Default,Huroi,0,0,0,,Bunu nasıl bildi?
Dialogue: 0,0:11:23.20,0:11:27.90,Default,Huroi,0,0,0,,İlk gizli görevim, ve işte\Nböyle mi başarısız oluyor?
Dialogue: 0,0:11:27.90,0:11:31.25,Default,System,0,0,0,,{\i1}Sistem uyarısı. Görev değişti.
Dialogue: 0,0:11:31.96,0:11:34.13,Default,System,0,0,0,,{\i1}Yeni görevin “Bekleme (S).”
Dialogue: 0,0:11:33.25,0:11:39.01,screen_text,sign,0,0,0,,{\an9\bord0\p1\fscy220\alpha&H20&\c&H6F5C50&}m 0 0 l 600 0 600 318 0 318
Dialogue: 0,0:11:34.13,0:11:35.84,Default,Huroi,0,0,0,,Görev mi değişti?
Dialogue: 0,0:11:34.81,0:11:37.82,Default,System,0,0,0,,{\i1}Bu görev son derece tehlikeli.
Dialogue: 0,0:11:36.44,0:11:39.01,Default,Huroi,0,0,0,,Gerçek gizli görev bu mu?
Dialogue: 0,0:11:37.82,0:11:41.82,Default,System,0,0,0,,{\i1}Fiziksel durumunuzdan endişe\Nduyuyorsanız, lütfen görevden vazgeçin.
Dialogue: 0,0:11:39.63,0:11:43.15,Default,Huroi,0,0,0,,{\an8}Sekiz gün mü?! Bu gerçek\Nzamanla elli saat eder!
Dialogue: 0,0:11:43.85,0:11:47.37,Default,Huroi,0,0,0,,Şimdiye kadar en fazla\Nyapabildiğim yirmi saatti!
Dialogue: 0,0:11:48.42,0:11:49.67,Default,Huroi,0,0,0,,Elli saat...
Dialogue: 0,0:11:50.03,0:11:52.65,Default,Huroi,0,0,0,,Beyin dalgalarımda herhangi bir \Nanormal durum olursa,
Dialogue: 0,0:11:53.44,0:11:55.82,Default,Huroi,0,0,0,,oyun beni kendiliğinden oyundan atacak!
Dialogue: 0,0:11:56.81,0:11:58.77,Default,Huroi,0,0,0,,Ve o zaman elimde hiçbir şey kalmayacak!
Dialogue: 0,0:11:59.96,0:12:01.11,screen_text,sign,0,0,0,,{\fad(134,0)\fs45\c&HEEEBEB&\bord1\3c&H655B57&\blur1.5\b1\pos(962,354)}Görevi bırakacak mısın?
Dialogue: 0,0:12:07.87,0:12:10.37,screen_text,sign,0,0,0,,{\3c&H5C4F45&\c&HEEEBEB&\bord1\blur1.5\b1\pos(1032,18)\frz357.6\frx4\fry10}Görevi bırakacak mısın?
Dialogue: 0,0:12:14.37,0:12:16.60,screen_text,sign,0,0,0,,{\3c&H5C4F45&\c&HEEEBEB&\bord1\blur1.5\b1\pos(1032,18)\frz357.6\frx4\fry10}Görevi bırakacak mısın?
Dialogue: 0,0:12:16.44,0:12:17.67,screen_text,sign,0,0,0,,{\fad(170,0)\3c&H5C4F45&\c&HEDEBEB&\bord0.75\blur2.3\b1\frz358\frx10\fry10\pos(1028,24)}Görev Alındı
Dialogue: 0,0:12:16.44,0:12:17.67,screen_text,sign,0,0,0,,{\fs39\fad(170,0)\3c&H5C4F45&\c&HEEEBEB&\bord0.5\blur1.5\b1\frx12\fry10\frz359.2\pos(1024,218)}Kalan Süre
Dialogue: 0,0:12:18.28,0:12:20.73,Default,Huroi,0,0,0,,Ne olursa olsun bu görevi tamamlayacağım!
Dialogue: 0,0:12:22.17,0:12:24.82,Default,Huroi,0,0,0,,Bekliyorum, Adalet Elçisi!
Dialogue: 0,0:12:30.03,0:12:32.30,Default,Hinako,0,0,0,,B408 görevi başladı.
Dialogue: 0,0:12:32.65,0:12:34.98,Default,Hinako,0,0,0,,Acil bir yönetim kurulu\Ntoplantısı başlatacağız.
Dialogue: 0,0:12:34.98,0:12:36.90,screen_text,sign,0,0,0,,{\blur0.8\bord0\b1\fs30\c&HB7B5B5&\pos(1482,740)}Kalan Süre
Dialogue: 0,0:12:37.53,0:12:39.40,Default,Yazaki,0,0,0,,B408...
Dialogue: 0,0:12:39.62,0:12:44.16,Default,Futaba,0,0,0,,Sadece özel koşullar altında ortaya\Nçıkan bir S-sınıfı gizli görev mi?
Dialogue: 0,0:12:44.16,0:12:44.85,Default,Hinako,0,0,0,,Evet.
Dialogue: 0,0:12:44.85,0:12:47.91,Default,Hinako,0,0,0,,Eğer tamamlanırsa,\Nbu, iki mesleğe sahip ilk
Dialogue: 0,0:12:48.36,0:12:51.29,Default,Hinako,0,0,0,,{\i1}Satisfy{\i0} kullanıcısının ortaya\Nçıkmasına neden olacak.
Dialogue: 0,0:12:51.71,0:12:55.43,Default,Sakeda,0,0,0,,Şimdiye kadar insanlar nadir\Nmeslekler üzerine odaklanmıştı.
Dialogue: 0,0:12:55.77,0:13:00.50,Default,Sakeda,0,0,0,,Ancak ikinci mesleklerin varlığı\Nortaya çıktığında bu durum değişecek.
Dialogue: 0,0:13:01.21,0:13:05.92,Default,Sakeda,0,0,0,,Bu görev, {\i1}Satisfy{\i0} için\Nbüyük bir öneme sahiptir.
Dialogue: 0,0:13:09.82,0:13:14.53,Default,Hinako,0,0,0,,Görev 408B’yi denemeye çalışan\Noyuncunun kimliği Huroi’dir.
Dialogue: 0,0:13:14.89,0:13:17.60,Default,Hinako,0,0,0,,Gerçek adı Damb Allunbatar’dır.
